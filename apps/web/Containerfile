# Build context: repository root (scripts/run.sh build).
ARG NODE_VERSION=22
FROM docker.io/library/node:${NODE_VERSION}-slim AS build
WORKDIR /app
RUN npm install -g pnpm@10.34.7

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/contracts/package.json ./apps/contracts/
COPY apps/web/package.json ./apps/web/
COPY apps/frontend/package.json ./apps/frontend/
RUN pnpm install --frozen-lockfile --filter "@skail-usd-quote/web..." --filter "@skail-usd-quote/frontend..."

COPY apps/contracts ./apps/contracts
COPY apps/web ./apps/web
COPY apps/frontend ./apps/frontend
RUN pnpm --filter "@skail-usd-quote/web..." --filter "@skail-usd-quote/frontend..." build

FROM docker.io/library/node:${NODE_VERSION}-slim
WORKDIR /app
RUN npm install -g pnpm@10.34.7
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/contracts/package.json ./apps/contracts/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile --prod --filter "@skail-usd-quote/web..."
COPY --from=build /app/apps/contracts/dist ./apps/contracts/dist
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/apps/frontend/dist ./apps/frontend/dist

# SKAIL_WORKLOAD, SKAIL_NAMESPACE, SKAIL_KEY, SKAIL_SIDECAR arrive with --env-file .env at run time
ENV PORT=8080
EXPOSE 8080
WORKDIR /app/apps/web
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "--enable-source-maps", "dist/main.js"]
